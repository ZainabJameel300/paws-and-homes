<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/homepage.css">
    <style>
@import url('https://fonts.googleapis.com/css2?family=LINE+Seed+JP&family=Lily+Script+One&family=Lora:ital,wght@0,400..700;1,400..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap');
</style>
</head>
<body>
    <%- include('./partials/navbar') %>
   <div class="top-section">
    <div class="left-section">
        <div class="title">
            <h1>Every Cat</h1>
            <h1>Deserves a</h1>
            <h1 id="cursive-word">Loving</h1>
            <h1>Home</h1>
        </div>

        <a href="/cat" class="browse-button">
            Browse Our Cats <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <img src="/assets/brown.png" alt="Home page cat image">
</div>
<div id="middle-line">
    </div>

    <div class="featured-section">

    <div class="featured-heading">
        <h2>
            <i class="fa-solid fa-paw"></i>
            Featured Cats
            <i class="fa-solid fa-paw"></i>
        </h2>

        <p>Meet some of our lovely cats looking for a home</p>
    </div>

    <div class="cat-cards-container">

        <% for (let oneCat of cats) { %>

            <div class="card">

                <div class="cat-owner-info">

                    <img class="owner-photo"
                         src="<%= oneCat.owner.profilePhoto %>"
                         alt="Cat owner profile photo">

                    <div class="username-time">
                        <p class="username"><%= oneCat.owner.username %></p>

                        <p class="time">
                            <%= new Date(oneCat.createdAt).toLocaleDateString('en-GB') %>
                        </p>
                    </div>

                </div>

                <img class="img"
                     src="<%= oneCat.image %>"
                     alt="<%= oneCat.name %>">

                <div class="cat-details">

                    <p class="cat-name"><%= oneCat.name %></p>

                    <p><%= oneCat.age %> years · <%= oneCat.gender %></p>

                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        <%= oneCat.location.address %>
                    </p>

                    <a href="/cat/<%= oneCat._id %>">
                        <button type="button">
                            View Details
                            <i class="fa fa-long-arrow-right"></i>
                        </button>
                    </a>

                </div>

            </div>

        <% } %>

    </div>

</div>
</body>
</html>