<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List a Cat</title>
    <link rel="stylesheet" href="/css/list-cat.css">
</head>
<body>
    <%- include('../partials/navbar') %>
   <div class="page-container">

    <div class="page-heading">
        <h1>List a Cat</h1>
        <h3>Help a cat find a loving home</h3>
    </div>

    <div class="form-container">
        <form class="list-form" action="/cat" method="post" enctype="multipart/form-data">

            <div class="form-group">
                <label for="name">Cat's Name:</label>
                <input name="name" id="name" type="text" placeholder="e.g. Luna">
            </div>

            <div class="form-group">
                <label for="age">Age:</label>
                <input name="age" id="age" type="number" placeholder="e.g. 2">
            </div>

            <div class="form-group">
                <label for="breed">Cat Breed:</label>
                <select name="breed" id="breed">
                    <option value="" disabled selected>Select Breed</option>
                    <option value="domestic-shorthair">Domestic Shorthair</option>
                    <option value="domestic-mediumhair">Domestic Mediumhair</option>
                    <option value="domestic-longhair">Domestic Longhair</option>
                    <option value="mixed-breed">Mixed Breed / Unknown</option>
                    <option value="bengal">Bengal</option>
                    <option value="british-shorthair">British Shorthair</option>
                    <option value="maine-coon">Maine Coon</option>
                    <option value="persian">Persian</option>
                    <option value="ragdoll">Ragdoll</option>
                    <option value="russian-blue">Russian Blue</option>
                    <option value="siamese">Siamese</option>
                    <option value="sphynx">Sphynx</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="gender">Cat Gender:</label>
                <select name="gender" id="gender">
                    <option value="" disabled selected>Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="form-group full-width">
                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="4"
                    placeholder="Tell us a little about your cat..."></textarea>
            </div>

            <div class="form-group full-width">
                <label for="image">Cat Photo:</label>
                <input name="image" id="image" type="file" placeholder="Paste an image URL for now" accept="image/*">
            </div>

<div class="form-group full-width">
    <label>Cat's Location:</label>

   <!-- provider="leaflet" this is the map provider (it baiscally uses leaflet to display the map but OpenStreetMap is the one providing the actual geographic map data ) --> 
    <!-- center , this baiscally controls where the map is pinned when it's initially opens -->
     <!-- lat-name="latitude"
        lng-name="longitude" when the form is submitted save the lat and the long under these names in the request body -->
        <!-- address-name="address" this saves the readable adress as adress in the request body -->
         <!-- search : this enables the search box in the location picker (this is a boolean attribute so it does not need to be declared)-->
          <!-- reverse-geocode , when this is enabled it enable us to convert a location cordinate into a readable address -->
           <!-- locate="button" , this adds the locate me button -->
    <location-picker
        id="cat-location"
        provider="leaflet"   
        center="26.2235,50.5876"
        lat-name="latitude"
        lng-name="longitude"
        address-name="address"
        search
        reverse-geocode
        locate="button"
        required
        style="height: 350px">
    </location-picker>
</div>
            <div class="form-group">
                <label>Is the cat vaccinated?</label>
                <div class="radio-options">
                    <label><input type="radio" name="isVaccinated" value="true"> Yes</label>
                    <label><input type="radio" name="isVaccinated" value="false"> No</label>
                </div>
            </div>

            <div class="form-group">
                <label>Is the cat neutered?</label>
                <div class="radio-options">
                    <label><input type="radio" name="isNeutered" value="true"> Yes</label>
                    <label><input type="radio" name="isNeutered" value="false"> No</label>
                </div>
            </div>

            <button type="submit">List a Cat for Adoption</button>

        </form>
    </div>

    

</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 <!-- Some of this code is inspired by https://developer.mozilla.org/en-US/docs/Web/API/Event/preventDefault to understand how to prevent the form from submiting immediately -->
<script>
    const createForms = document.querySelectorAll(".list-form"); //first we cache the update form element 

    createForms.forEach(function(form) { //then we create a functin that for each click add an event listner

        form.addEventListener("submit", function(event) {

            event.preventDefault(); 

            Swal.fire({
                title: "Ready to List your cat?",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#6B4A2E",
                cancelButtonColor: "#A99A8A",
                confirmButtonText: "Yes, Continue",
                cancelButtonText: "Cancel"
            }).then(function(result) {

                if (result.isConfirmed) {
                    form.submit(); 
                }

            });

        });

    });
</script>
    <script src="https://cdn.jsdelivr.net/npm/location-picker@3"></script>
</body>
</html>