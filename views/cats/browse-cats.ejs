<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse Cats</title>
    <link rel="stylesheet" href="/css/browse-cats.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="page-container">
    <div class="page-heading">
        <h1>Browse Cats</h1>
        <h3>Find your perfect furry friend</h3>
    </div>

    
    <form  action="/cat" method="GET" class="filters-container">
       <div class="filters-container">

    <div class="filter">
        <label for="gender">Gender</label>
        <select name="gender" id="gender" onchange="window.location.href=this.value">
            <option value="/cat" <%= !gender ? 'selected' : '' %>>All Genders</option>
            <option value="/cat?gender=Male" <%= gender === 'Male' ? 'selected' : '' %>>Male</option>
        <option value="/cat?gender=Female" <%= gender === 'Female' ? 'selected' : '' %>>Female</option>
        </select>
    </div>

    <div class="filter">
    <label for="breed">Breed</label>
    <select name="breed" id="breed" onchange="window.location.href=this.value">

        <option value="/cat" <%= !breed ? 'selected' : '' %>>All Breeds</option>
        <option value="/cat?breed=domestic-shorthair" <%= breed === 'domestic-shorthair' ? 'selected' : '' %>>Domestic Shorthair</option>
        <option value="/cat?breed=domestic-mediumhair" <%= breed === 'domestic-mediumhair' ? 'selected' : '' %>>Domestic Mediumhair</option>
        <option value="/cat?breed=domestic-longhair" <%= breed === 'domestic-longhair' ? 'selected' : '' %>>Domestic Longhair</option>
        <option value="/cat?breed=mixed-breed" <%= breed === 'mixed-breed' ? 'selected' : '' %>>Mixed Breed / Unknown</option>
        <option value="/cat?breed=bengal" <%= breed === 'bengal' ? 'selected' : '' %>>Bengal</option>
        <option value="/cat?breed=british-shorthair" <%= breed === 'british-shorthair' ? 'selected' : '' %>>British Shorthair</option>
        <option value="/cat?breed=maine-coon" <%= breed === 'maine-coon' ? 'selected' : '' %>>Maine Coon</option>
        <option value="/cat?breed=persian" <%= breed === 'persian' ? 'selected' : '' %>>Persian</option>
        <option value="/cat?breed=ragdoll" <%= breed === 'ragdoll' ? 'selected' : '' %>>Ragdoll</option>
        <option value="/cat?breed=russian-blue" <%= breed === 'russian-blue' ? 'selected' : '' %>>Russian Blue</option>
        <option value="/cat?breed=siamese" <%= breed === 'siamese' ? 'selected' : '' %>>Siamese</option>
        <option value="/cat?breed=sphynx" <%= breed === 'sphynx' ? 'selected' : '' %>>Sphynx</option>
        <option value="/cat?breed=other" <%= breed === 'other' ? 'selected' : '' %>>Other</option>

    </select>
</div>

    <div class="filter">
    <label for="age">Age</label>
    <select name="age" id="age" onchange="window.location.href=this.value">
        <option value="/cat" <%= !age ? 'selected' : '' %>>All Ages</option>
        <option value="/cat?age=1-5" <%= age === '1-5' ? 'selected' : '' %>>1–5 Years</option>
        <option value="/cat?age=6-10" <%= age === '6-10' ? 'selected' : '' %>>6–10 Years</option>
        <option value="/cat?age=11%2B" <%= age === '11+' ? 'selected' : '' %>>11+ Years</option>

    </select>
</div>

</div>
   </form>


    <div class="cat-cards-container">
    <% for(let oneCat of cats){ %>
        <div class="card">
         <div class="cat-owner-info">

    <img class="owner-photo" src="<%= oneCat.owner.profilePhoto %>" alt="Cat owner profile photo">

    <div class="username-time">

        <p class="username"><%= oneCat.owner.username %></p>

        <!-- This code is inspired by MDN Web Docs (Mozilla Developer Network) articles -->
         <!-- and this youtube video https://www.youtube.com/watch?v=LwYwz67l1lA -->

        <%
            const createdAt = new Date(oneCat.createdAt); //saves the date of the post creation in createdAt using JS Date object

            const today = new Date(); //this gets you the current date and time
            today.setHours(0, 0, 0, 0); //this set the today const time to 0:0:0:0 (we want to compare the date only not the time)

            const yesterday = new Date(today); //these 2 lines gets us yestrdays date
            yesterday.setDate(yesterday.getDate() - 1);

            const listingDate = new Date(createdAt); //these 2 lines gets the lisiting date and also set the time to 0
            listingDate.setHours(0, 0, 0, 0);

            let displayDate;

            if (listingDate.getTime() === today.getTime()) {
                displayDate = "Today";
            } else if (listingDate.getTime() === yesterday.getTime()) {
                displayDate = "Yesterday";
            } else {
                displayDate = createdAt.toLocaleDateString('en-GB');
            }

            const displayTime = createdAt.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit'
            });
        %>

        <p class="time">
            <%= displayDate %>
            <% if (displayDate === "Today" || displayDate === "Yesterday") { %>
                · <%= displayTime %>
            <% } %>
        </p>

    </div>

</div> 
        <img class="img" src="<%= oneCat.image%>" alt="<%= oneCat.name %>">
        <div class="cat-details">
        <p class="cat-name"><%= oneCat.name%></p>
        <p><%= oneCat.age%> years · <%=oneCat.gender%></p>
        <p>
            <i class="fa-solid fa-location-dot"></i>
            <%=oneCat.location.address%>
        </p>
        <a href="/cat/<%=oneCat._id%>"><button type="button">View Details <i class="fa fa-long-arrow-right" aria-hidden="true"></i></button></a>
        </div>
         </div>
     <% }%>
       </div> 

       <!-- This code is inspired by this youtube video here -> 
Adding Pagination in Node.js | Efficient Data Handling (https://www.youtube.com/watch?v=oKPA0lLyL_8&t=17s) -->

<% if (totalPages > 1) { %>

    <div class="pagination">


        <!-- this checks whethter the current page is greater than 1 because if it's not we do not need to display the previous button -->
        <% if (currentPage > 1) { %>
            <!-- this will take us to the previous page -->
            <a href="/cat?page=<%= currentPage - 1 %>"> 
                Previous
            </a>
        <% } %>


        <% for (let i = 1; i <= totalPages; i++) { %>

            <a href="/cat?page=<%= i %>"
               class="<%= currentPage === i ? 'active' : '' %>">

                <%= i %>

            </a>

        <% } %>


        <% if (currentPage < totalPages) { %>
            <a href="/cat?page=<%= currentPage + 1 %>">
                Next
            </a>
        <% } %>

    </div>

<% } %>
    </div>
</body>
</html>