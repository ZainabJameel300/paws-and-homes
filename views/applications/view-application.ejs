<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Application</title>
    <link rel="stylesheet" href="/css/view-application.css">
</head>
<body>
     <%- include('../partials/navbar') %>

    <div class="page-container">

        <div class="page-heading">
            <h1>View <%=application.cat.name %>'s Application</h1>
            <h3>Keep Track of Your Adoption Applications</h3>
        </div>

        <button id="go-back" onclick="history.back()"> <i class="fa fa-arrow-left" aria-hidden="true"></i> Go Back</button>

        <div class="application-content">

    <div class="form-container">

        <form class="application-form">

            <div class="form-group">
                <label for="message">Why would you like to adopt <%= application.cat.name %>?</label>
                <div class="text-area-container">
                <p><%= application.message %></p>
                </div>
            </div>

            <div class="form-group">
                <label for="livingSituation">Living Situation:</label>
                <div class="text-area-container">
                    <%= application.livingSituation %>
                </div>
            </div>

            <div class="form-group">
                <label>Do you have experience with cats?</label>

                <div class="radio-options">
                    <label>
                        <input type="radio" disabled
                            <%= application.experienceWithCats === true ? 'checked' : '' %>>
                        Yes
                    </label>

                    <label>
                        <input type="radio" disabled
                            <%= application.experienceWithCats === false ? 'checked' : '' %>>
                        No
                    </label>
                </div>
            </div>

        </form>

    </div>

    <div class="cat-image-container">
        <img src="<%= application.cat.image %>" alt="<%= application.cat.name %>">
    </div>

</div>
    </div>

</body>
</html>