<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply To Adopt</title>
    <link rel="stylesheet" href="/css/apply-to-adopt.css">
</head>
<body>

    <%- include('../partials/navbar') %>

    <div class="page-container">

        <div class="page-heading">
            <h1>Apply To Adopt <%= cat.name %></h1>
            <h3>Tell us why you'd be the perfect home for <%= cat.name %></h3>
        </div>

        <div class="form-container">

            <form class="application-form" action="/application/<%= cat._id %>" method="POST">

                <div class="form-group">
                    <label for="message">Why would you like to adopt <%= cat.name %>?</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Tell us why you'd love to adopt this cat..."
                        maxlength="500"
                        required></textarea>
                </div>

                <div class="form-group">
                    <label for="livingSituation">Living Situation:</label>
                    <textarea
                        id="livingSituation"
                        name="livingSituation"
                        rows="5"
                        placeholder="Tell us about your home and living environment..."
                        required></textarea>
                </div>

                <div class="form-group">
                    <label>Do you have experience with cats?</label>

                    <div class="radio-options">
                        <label>
                            <input type="radio" name="experienceWithCats" value="true" required>
                            Yes
                        </label>

                        <label>
                            <input type="radio" name="experienceWithCats" value="false">
                            No
                        </label>
                    </div>
                </div>

                <button type="submit">Submit Application</button>

            </form>

        </div>

    </div>

</body>
</html>
