<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Application Requests</title>
    <link rel="stylesheet" href="/css/view-application-request.css">
</head>
<body>

<%- include('../partials/navbar') %>

    <div class="page-container">

        <div class="page-heading">
            <h1>View <%=application.applicant.username %>'s Application</h1>
        </div>
          <a href="/application/applications-requests"">
          <button id="go-back"> <i class="fa fa-arrow-left" aria-hidden="true"></i> Go Back</button>
          </a>
        

        <div class="application-content">

    <div class="form-container">
        <div class="cat-owner-info">

    <img class="owner-photo" src="<%= application.applicant.profilePhoto %>" alt="Cat owner profile photo">

    <div class="username-time">

    <div class="username-row">

        <p class="username"><%= application.applicant.username %></p>

        <% if (application.status === "Accepted") { %>
            <span class="status-pill accepted">Accepted</span>

        <% } else if (application.status === "Rejected") { %>
            <span class="status-pill rejected">Rejected</span>
        <% } %>

    </div>

        <%
            const createdAt = new Date(application.createdAt);

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);

            const listingDate = new Date(createdAt);
            listingDate.setHours(0, 0, 0, 0);

            let displayDate;

            if (listingDate.getTime() === today.getTime()) {
                displayDate = "Today";
            } else if (listingDate.getTime() === yesterday.getTime()) {
                displayDate = "Yesterday";
            } else {
                displayDate = createdAt.toLocaleDateString('en-GB');
            }

            const displayTime = createdAt.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit'
            });
        %>

        <p class="time">
            <%= displayDate %>
            <% if (displayDate === "Today" || displayDate === "Yesterday") { %>
                · <%= displayTime %>
            <% } %>
        </p>

    </div>

</div>

        <div class="application-form">

            <div class="form-group">
                <label for="message">Why would you like to adopt <%= application.cat.name %>?</label>
                <div class="text-area-container">
                <p><%= application.message %></p>
                </div>
            </div>

            <div class="form-group">
                <label for="livingSituation">Living Situation:</label>
                <div class="text-area-container">
                    <%= application.livingSituation %>
                </div>
            </div>

            <div class="form-group">
                <label>Do you have experience with cats?</label>

                <div class="radio-options">
                    <label>
                        <input type="radio" disabled
                            <%= application.experienceWithCats === true ? 'checked' : '' %>>
                        Yes
                    </label>

                    <label>
                        <input type="radio" disabled
                            <%= application.experienceWithCats === false ? 'checked' : '' %>>
                        No
                    </label>
                </div>
            </div>

            <% if (application.status === "Pending") { %>

    <div class="acceptance-actions">

        <form action="/application/<%= application._id %>/accept" method="POST">
            <button class="acceptance-buttons" id="accept-button" type="submit">
                <i class="fa fa-check" aria-hidden="true"></i>
                Accept
            </button>
        </form>

        <form action="/application/<%= application._id %>/reject" method="POST">
            <button class="acceptance-buttons" id="reject-button" type="submit">
                <i class="fa fa-times" aria-hidden="true"></i>
                Reject
            </button>
        </form>

    </div>

<% } else if (application.status === "Accepted") { %>

    <a href="/appointment/new?application=<%= application._id %>" class="schedule-button">
        <i class="fa fa-calendar" aria-hidden="true"></i>
        Schedule Appointment
    </a>

<% } %>

</div>

    </div>

    <div class="cat-image-container">
        <img src="<%= application.cat.image %>" alt="<%= application.cat.name %>">
    </div>

</div>
    </div>
    
</body>
</html>