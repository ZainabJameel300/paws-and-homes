<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Applications</title>
    <link rel="stylesheet" href="/css/my-applications.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="page-container">

        <div class="page-heading">
            <h1>My Applications</h1>
            <h3>Keep Track of Your Adoption Applications</h3>
        </div>

        <% if(cats.length === 0) {%>
            <div class="empty-message">
                <h2>No Applications yet!</h2>
                <p>When a you apply for cats, they will apear here!</p>
            </div>
        <% } else{%>

        <div class="cat-grid">

        <% for(let application of cats) { %>

            <% if (application.cat) { %>

            <div class="cat-card-container">

                <img class="cat-img" src="<%= application.cat.image %>" alt="<%= application.cat.name %>">

                <div class="cat-info">

    <p class="cat-name"><%= application.cat.name %></p>

    <p class="age-gender">
        <%= application.cat.age %> Years · <%= application.cat.gender %>
    </p>

    <p class="time location-text">
        <i class="fa-solid fa-location-dot"></i>
        <%= application.cat.location ? application.cat.location.address : 'Location not available' %>
    </p>

    <%
                        const createdAt = new Date(application.cat.createdAt);

                        const today = new Date();
                        today.setHours(0, 0, 0, 0);

                        const yesterday = new Date(today);
                        yesterday.setDate(yesterday.getDate() - 1);

                        const listingDate = new Date(createdAt);
                        listingDate.setHours(0, 0, 0, 0);

                        let displayDate;

                        if (listingDate.getTime() === today.getTime()) {
                            displayDate = "Today";
                        } else if (listingDate.getTime() === yesterday.getTime()) {
                            displayDate = "Yesterday";
                        } else {
                            displayDate = createdAt.toLocaleDateString('en-GB');
                        }

                        const displayTime = createdAt.toLocaleTimeString('en-US', {
                            hour: 'numeric',
                            minute: '2-digit'
                        });
                    %>


    <p class="time">
        <i class="fa-regular fa-calendar"></i>
        <%= displayDate %>
        <% if (displayDate === "Today" || displayDate === "Yesterday") { %>
            · <%= displayTime %>
        <% } %>
    </p>

    <div class="two-buttons">

        <a href="/cat/<%= application.cat._id %>" class="view-cat-button">
            View Cat Details
            <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a href="/application/<%= application._id %>" class="view-application-button">
            View Application
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>

</div>

<div class="cat-actions">

    <div class="status <%= application.status.toLowerCase() %>">
        <%= application.status %>
    </div>

</div>

            </div>

            <% } %>

        <% } %>
        </div>

        <% }%>

    </div>

</body>
</html>
