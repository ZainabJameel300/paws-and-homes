<link rel="stylesheet" href="/css/nav-bar.css">
<link rel="stylesheet" href="/css/font.css">
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
>

<nav>
    <a href="/">
        <img id="logo" src="/assets/logo-nav-bar.png" alt="Paws & Homes">
    </a>
    

    <div class="nav-links <%= user ? 'logged-in' : 'logged-out' %>">
        <a href="/">Home</a>
        <a href="/cat">Browse Cats</a>
        <% if (user){ %>
            
            <a href="/cat/new">List a Cat</a>

            <div class="profile">
                <img id="profile-photo" src="<%=user.profilePhoto%>" alt="User profile photo">
                <label for="profile">My Profile </label>
                <select name="profile" id="profile" onchange="window.location.href=this.value">
                  <option value="" selected disabled>My Profile</option>
                  <option value="/applications">Application Requests</option>
                  <option value="/cat/<%= user._id %>/my-listings">My Listings</option>
                  <option value="/applications">My Applications</option>
                  <option value="/appointments">My Appointments</option>
            </select>
            </div>

            <a class="button logout-button" href="/auth/sign-out">Logout</a>

        <% } else { %>
            <a class="button" href="/auth/sign-up">Sign up</a>
            <a class="button" href="/auth/sign-in">Login</a>
        <% } %>
    </div>
</nav>