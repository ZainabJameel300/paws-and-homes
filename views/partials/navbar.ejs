
<link rel="stylesheet" href="/css/nav-bar.css">
<link rel="stylesheet" href="/css/font.css">
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
>

<nav>
    <a href="/">
        <img id="logo" src="/assets/logo-nav-bar.png" alt="Paws & Homes">
    </a>

    <div class="nav-links <%= user ? 'logged-in' : 'logged-out' %>">

        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">
            Home
        </a>

        <a href="/cat" class="<%= currentPath === '/cat' || (currentPath.startsWith('/cat/') && currentPath !== '/cat/new' && !currentPath.includes('/my-listings')) ? 'active' : '' %>">
            Browse Cats
        </a>

        <% if (user) { %>

            <a href="/cat/new" class="<%= currentPath === '/cat/new' ? 'active' : '' %>">
                List a Cat
            </a>

            
<div class="profile">
    <img
        id="profile-photo"
        src="<%= user.profilePhoto %>"
        alt="User profile photo"
    >

    
<select
    name="profile"
    id="profile"
    aria-label="Profile navigation"
    onchange="if (this.value) window.location.href = this.value"
>
    <option value="" disabled
        <%= !currentPath.startsWith('/application/applications-requests') &&
            !currentPath.includes('/my-listings') &&
            currentPath !== '/application' &&
            currentPath !== '/appointment'
            ? 'selected' : '' %>>
        My Profile
    </option>

    <option
        value="/application/applications-requests"
        <%= currentPath === '/application/applications-requests' ? 'selected' : '' %>>
        Application Requests
    </option>

    <option
        value="/cat/<%= user._id %>/my-listings"
        <%= currentPath.includes('/my-listings') ? 'selected' : '' %>>
        My Listings
    </option>

    <option
        value="/application"
        <%= currentPath === '/application' ? 'selected' : '' %>>
        My Applications
    </option>

    <option
        value="/appointment"
        <%= currentPath === '/appointment' ? 'selected' : '' %>>
        My Appointments
    </option>
</select>


    <i class="fa-solid fa-chevron-down profile-arrow"></i>
</div>


            <a class="button logout-button" href="/">
                <i class="fa fa-sign-out" aria-hidden="true"></i>
                <span> Logout</span>
            </a>

        <% } else { %>

            <a class="button" href="/auth/sign-up">Sign up</a>
            <a class="button" href="/auth/sign-in">Login</a>

        <% } %>

    </div>
</nav>
