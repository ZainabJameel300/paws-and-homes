<link rel="stylesheet" href="/css/nav-bar.css">
<link rel="stylesheet" href="/css/font.css">

<nav>
    <a href="/">
        <img id="logo" src="/assets/logo-nav-bar.png" alt="Paws & Homes">
    </a>
    

    <div class="nav-links <%= user ? 'logged-in' : 'logged-out' %>">
        <a href="/">Home</a>
        <a href="/cat">Browse Cats</a>
        <% if (user){ %>
            
            <a href="/cat/new">List a Cat</a>

            <div class="profile">
                <img id="profile-photo" src="<%=user.profilePhoto%>" alt="User profile photo">
                <label for="profile">My Profile </label>
                <select name="profile" id="profile">
                    <option value="My Listings">My Listings</option>
                    <option value="My Applications">My Applications</option>
                    <option value="My Appointments">My Appointments</option>
                </select>
            </div>

            <a class="button logout-button" href="/auth/sign-out">Logout</a>

        <% } else { %>
            <a class="button" href="/auth/sign-up">Sign up</a>
            <a class="button" href="/auth/sign-in">Login</a>
        <% } %>
    </div>
</nav>